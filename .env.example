# Use the production HTTPS origin before allowing indexing.
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
SITE_TIME_ZONE=Asia/Dhaka
# Optional. Enables durable subscriptions and editorial publishing.
# DATABASE_URL=postgresql://user:password@localhost:5432/everyday
# Google Search Console HTML verification token.
# GOOGLE_SITE_VERIFICATION=
# On Vercel, set only after enabling Analytics for your project.
# NEXT_PUBLIC_VERCEL_ANALYTICS=false
